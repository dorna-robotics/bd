# bd — run parameters (rendered as Jinja2, then parsed as YAML).
#
# Split out of launch.yaml the same way recipes.j2 is: launch.yaml
# points here (``kwargs: hmi/kwargs.j2``), this file owns the schema.
# The top level IS the schema — one entry per field.
#
# Fields render stacked in declaration order. ``_layout: [{row: [a, b]}]``
# would place fields side by side — not used here: the rack reads better
# with the run options directly under it.

# DEMO ONLY — a second rack so the tab layout can be seen. bd has one
# falcon rack; this field points at the same component and is ignored
# by setup(). Delete both this field and the _layout block to go back.
_layout:
  - tabs: [tubes, tubes_demo]
    label: "Load racks"
    hint: >-
      Every rack on the bench, from the scene — tap a rack to edit it.
      Selected positions run; each carries its own dose.

tubes_demo:
  type: slots
  component: rack_falcon_15ml_1
  exclude: ["D5"]
  exclude_label: "SOURCE"
  quick: [all, clear]
  default: []
  label: "IN — tray 2 (demo)"
  hint: Fake second rack, here only to show the tab layout.

tubes:
  type: slots
  component: rack_falcon_15ml_1
  exclude: ["D5"]
  exclude_hint: "Reservoir (D5) — never processed"
  exclude_label: "SOURCE"
  quick: [all, clear]          # bulk actions offered beside the grid
  # Per-position value: each selected tube carries its own dose, so the
  # kwarg arrives as {slot: mL} instead of a plain list.
  value:
    label: Dispense
    unit: mL
    default: 0.4
    min: 0.1
    max: 5.0
    step: 0.1
  default: ["A1"]
  label: "IN — tray 1"
  hint: Tap the rack positions you loaded. Each selected tube runs the full chain.

print_label:
  type: bool
  default: false
  label: Print label
  hint: Print and apply a barcode label on each tube (on the printer, right after the pick) before it is decapped. Off skips the printer entirely.
