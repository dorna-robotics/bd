# bd — run parameters (rendered as Jinja2, then parsed as YAML).
#
# Split out of launch.yaml the same way recipes.j2 is: launch.yaml
# points here (``kwargs: hmi/kwargs.j2``), this file owns the schema.
# The top level IS the schema — one entry per field.
#
# Fields render stacked in declaration order. ``_layout: [{row: [a, b]}]``
# would place fields side by side — not used here: the rack reads better
# with the run options directly under it.

tubes:
  type: slots
  component: rack_falcon_15ml_1
  exclude: ["D5"]
  exclude_hint: "Reservoir (D5) — never processed"
  exclude_label: "SOURCE"
  default: ["A1"]
  label: Tubes to process
  hint: Tap the rack positions you loaded. Each selected tube runs the full chain.

print_label:
  type: bool
  default: false
  label: Print label
  hint: Print and apply a barcode label on each tube (on the printer, right after the pick) before it is decapped. Off skips the printer entirely.
