# bd — the kwargs' defaults. Each entry IS its default; nothing here
# says how anything looks (labels, units, limits live in hmi/setup.js,
# the screen that sets these).
#
# Read headlessly too: `replay --batch N` slices the first N tubes
# straight out of this map, so it lists every processable position in
# run order. D5 is the reservoir — dispensed FROM, never processed —
# so it is not in the map.

{% set dose = 0.4 %}

tubes:
{% for r in ['A', 'B', 'C', 'D'] %}{% for c in [1, 2, 3, 4, 5] %}{% if r ~ c != 'D5' %}
  "{{ r }}{{ c }}": {{ dose }}
{%- endif %}{% endfor %}{% endfor %}

print_label: false
